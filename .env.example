# URL lengkap REST API backend (termasuk /api). Wajib diisi saat deploy terpisah.
# Bila kosong: mode dev memakai proxy /api → VITE_PROXY_TARGET, mode build memakai
# https://ifs24044-pabwe2026-sk-p9-be-golang-gin.s1if.cloud/api
VITE_API_BASE_URL=

# Target proxy Vite saat `npm run dev` / `npm run preview` (backend Golang lokal).
VITE_PROXY_TARGET=http://localhost:8081
VITE_PORT=5174
